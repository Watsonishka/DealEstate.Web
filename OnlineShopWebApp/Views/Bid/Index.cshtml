@model BidViewModel

@if (Model == null || Model.Items == null || !Model.Items.Any())
{
    <div class="container mt-5">
        <div class="realEstate-card p-5">
            <div class="text-center">
                <div class="empty-order-icon-wrapper">
                    <i class="fas fa-building"></i>
                </div>

                <h1 class="main-title">
                    Заявка пуста
                </h1>

                <p class="subtitle mt-3 mb-4">
                    Здесь будут отображаться все объекты недвижимости,
                    которые вы хотите оформить в заказ.
                </p>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-main px-4 py-3">
                    Начать поиск недвижимости
                </a>

            </div>
        </div>
    </div>
}
else
{
    <div class="container mt-5">

        <div class="mb-5">
            <h1 class="main-title">Моя заявка</h1>
            <p class="subtitle">
                Выбрано объектов: @Model.Items.Count
            </p>
        </div>

        <div class="row">

            <div class="col-lg-8">

                @foreach (var item in Model.Items)
                {
                    <div class="realEstate-card shadow-sm p-3 mb-4">
                        <div class="row align-items-center">
                            <div class="col-md-4">
                                <img src="@item.Product.PreviewImagePath"
                                     class="img-fluid rounded"
                                     alt="Real Estate">
                            </div>

                            <div class="col-md-5">
                                <div class="developer-name mb-2">
                                    @item.Product.Developer
                                </div>
                                <h4 class="realEstate-title">
                                    @item.Product.Name
                                </h4>
                                <div class="location mb-2">
                                    <i class="fas fa-location-dot"></i> @item.Product.City
                                </div>
                                <div class="description">
                                    <i class="fas fa-arrows-alt"></i> @item.Product.Area м²
                                </div>
                            </div>

                            <div class="col-md-3 text-end">
                                <div class="order-item-actions">
                                    <div class="order-item-price mb-3">
                                        @item.Product.Cost.ToString("C")
                                    </div>
                                    <a asp-controller="Bid"
                                       asp-action="Remove"
                                       asp-route-productId="@item.Product.ID"
                                       class="btn-outline order-item-remove">
                                        Удалить
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="services-list">
                            <div class="developer-name services-title">
                                Дополнительные услуги:
                            </div>

                            @if (item.Services != null && item.Services.Any())
                            {
                                foreach (var service in item.Services)
                                {
                                    <div class="selected-service-item mb-2 d-flex justify-content-between align-items-center @(service.IsRemoved ? "service-removed" : "")">
                                        <span>@service.Name - <span class="service-price">@service.Price.ToString("C")</span></span>

                                        <form asp-controller="Bid"
                                              asp-action="ToggleService"
                                              method="post"
                                              class="service-toggle-form">
                                            <input type="hidden" name="productId" value="@item.Product.ID" />
                                            <input type="hidden" name="serviceId" value="@service.ID" /> 
                                            @if (service.IsRemoved)
                                            {
                                                <button type="submit" class="service-toggle-btn restore-btn">
                                                    <i class="fas fa-undo-alt"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="service-toggle-btn remove-btn">
                                                    <i class="fas fa-times-circle"></i>
                                                </button>
                                            }
                                        </form>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-muted mb-2">Услуги не добавлены</div>
                            }
                        </div>
                    </div>
                }

            </div>

            <div class="col-lg-4">
                <div class="summary-card">
                    <h3 class="section-title mb-4">Итого по подборке</h3>

                    <div class="summary-row">
                        <span class="summary-label">Стоимость недвижимости:</span>
                        <span class="summary-value">@Model.ProductsTotalPrice.ToString("C")</span>
                    </div>

                    <div class="summary-spacer"></div>

                    <div class="summary-row">
                        <span class="summary-label">Стоимость услуг:</span>
                        <span class="summary-value">@Model.ServicesTotalPrice.ToString("C")</span>
                    </div>

                    <div class="reward-block">
                        <div class="reward-content">
                            <div>
                                <i class="fas fa-user-tie reward-icon"></i>
                                <span class="reward-label">Вознаграждение менеджера</span>
                                <div class="reward-percent">(0.002% от суммы)</div>
                            </div>
                            <span class="reward-amount">@Model.ManagerReward.ToString("C")</span>
                        </div>
                    </div>

                    <hr class="separator" />

                    <div class="total-row">
                        <span class="total-label">ИТОГО:</span>
                        <span class="total-amount">@((Model.ManagerReward + Model.ServicesTotalPrice).ToString("C"))</span>
                    </div>

                    <hr class="separator" />

                    <div class="d-grid gap-3">
                        <a asp-controller="Order"
                           asp-action="Registrate"
                           asp-route-userId="@Model.UserID"
                           class="btn btn-main py-3">
                            Заказать консультацию
                        </a>
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn-outline py-3">
                            Продолжить поиск
                        </a>
                        <a asp-controller="Bid"
                           asp-action="Clear"
                           asp-route-userId="@Model.UserID"
                           class="btn-outline py-3">
                            Очистить заявку
                        </a>
                    </div>

                    <div class="contact-block">
                        <div class="contact-divider"></div>
                        <div class="contact-title">
                            Остались вопросы?
                        </div>
                        <a href="tel:@Model.ManagerPhoneNumber" class="contact-phone">
                            <i class="fas fa-headset"></i>
                            @Model.ManagerPhoneNumber
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
}