@model List<ProductViewModel>

@{
    ViewData["Title"] = "Каталог недвижимости";
}

<div class="container mt-5">

    <div class="mb-5">
        <h1 class="main-title">Каталог недвижимости</h1>
        <p class="subtitle">
            Найдено объявлений: @Model.Count
        </p>
    </div>

    @await Html.PartialAsync("SearchBar")

    <div class="hero-slider mt-5 mb-5">

        <div id="catalogHero"
             class="carousel slide carousel-fade"
             data-bs-ride="carousel"
             data-bs-interval="6500"
             data-bs-pause="false">

            <div class="carousel-inner">

                <div class="carousel-item active">
                    <img src="~/img/preview1.png"
                         class="d-block w-100 hero-image"
                         alt="">
                </div>

                <div class="carousel-item">
                    <img src="~/img/preview2.png"
                         class="d-block w-100 hero-image"
                         alt="">
                </div>

                <div class="carousel-item">
                    <img src="~/img/preview3.png"
                         class="d-block w-100 hero-image"
                         alt="">
                </div>

            </div>

            <div class="hero-overlay">

                <h2 class="hero-title">
                    Выберите недвижимость своей мечты!
                </h2>

                <p class="hero-subtitle">
                    Современные квартиры и частные дома
                    в лучших районах города
                </p>

                <div class="hero-buttons">

                    <a href="#apartments"
                       class="btn btn-main">
                        Квартиры
                    </a>

                    <a href="#houses"
                       class="btn btn-outline">
                        Дома
                    </a>

                </div>

            </div>

        </div>

    </div>

    @{
        var apartments = Model.Where(x => x.Category == Category.Apartments).ToList();
        var houses = Model.Where(x => x.Category == Category.Houses).ToList();
    }

    @if (apartments.Any())
    {
        <h2 id="apartments" class="section-title mb-4">
            Квартиры
        </h2>
        <div class="row g-4 mb-5">
            @foreach (var apartment in apartments)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card realEstate-card shadow-sm h-100">
                        <img class="card-img-top realEstate-image"
                             src="@apartment.PreviewImagePath"
                             alt="Apartment">
                        <span class="realEstate-type-badge">
                            @EnumHelper.GetDescription(apartment.Class)
                        </span>
                        <div class="card-body d-flex flex-column">
                            <div class="mb-2 fw-semibold developer-name">
                                @apartment.Developer
                            </div>
                            <a asp-controller="Product"
                               asp-action="Index"
                               asp-route-id="@apartment.ID"
                               class="property-card-link">
                                @apartment.Name
                            </a>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="location">
                                    <i class="fas fa-location-dot"></i> @apartment.City
                                </div>
                                <div class="location">
                                    <i class="fas fa-arrows-alt"></i> @apartment.Area м²
                                </div>
                            </div>
                            <div class="d-grid gap-3">
                                <div class="price mb-3">
                                    @apartment.Cost.ToString("C")
                                </div>
                                <a asp-area =""
                                   asp-controller="Product"
                                   asp-action="Index"
                                   asp-route-id="@apartment.ID"
                                   class="btn btn-main w-100">
                                    Подробнее
                                </a>
                                <a asp-area =""
                                asp-controller="Comparison"
                                asp-action="Add"
                                asp-route-productID="@apartment.ID"
                                class="btn-outline w-100">
                                <i class="fas fa-magnifying-glass me-2"></i>Добавить в сравнение
                            </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (houses.Any())
    {
        <h2 id="houses" class="section-title mb-4 mt-5">
            Частные дома
        </h2>
        <div class="row g-4">
            @foreach (var house in houses)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card realEstate-card shadow-sm h-100">
                        <img class="card-img-top realEstate-image"
                             src="@house.PreviewImagePath"
                             alt="House">
                        <div class="card-body d-flex flex-column">
                            <div class="mb-2 fw-semibold developer-name">
                                @house.Developer
                            </div>
                            <a asp-area =""
                               asp-controller="Product"
                               asp-action="Index"
                               asp-route-id="@house.ID"
                               class="property-card-link">
                                @house.Name
                            </a>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="location">
                                    <i class="fas fa-location-dot"></i> @house.City
                                </div>
                                <div class="location">
                                    <i class="fas fa-arrows-alt"></i> @house.Area м²
                                </div>
                            </div>
                            <div class="d-grid gap-3">
                                <div class="price mb-3">
                                    @house.Cost.ToString("C")
                                </div>
                                <a asp-area =""
                                   asp-controller="Product"
                                   asp-action="Index"
                                   asp-route-id="@house.ID"
                                   class="btn btn-main w-100">
                                    Подробнее
                                </a>
                                <a asp-area =""
                                asp-controller="Comparison"
                                asp-action="Add"
                                asp-route-productId="@house.ID"
                                class="btn-outline w-100">
                                <i class="fas fa-magnifying-glass me-2"></i>Добавить в сравнение
                                 </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (!apartments.Any() && !houses.Any())
    {
        <div class="col-12">
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="fas fa-search"></i>
                </div>
                <h3 class="empty-state-title">Ничего не найдено</h3>
                <p class="empty-state-text">
                    Попробуйте изменить параметры поиска или<br />
                    посмотрите другие категории недвижимости
                </p>
                <a asp-area =""
                   asp-controller="Home" 
                   asp-action="Index" 
                   class="btn-main px-4 py-2" style="display: inline-block; margin-top: 15px;">
                    <i class="fas fa-arrow-left me-2"></i>Вернуться к каталогу
                </a>
            </div>
        </div>
    }

</div>