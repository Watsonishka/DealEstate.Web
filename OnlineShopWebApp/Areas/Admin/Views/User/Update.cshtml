@model UserViewModel

@{
    ViewData["Title"] = $"Редактирование пользователя #{Model?.ID.ToString()[..8].ToUpper()}";
}

<div class="admin-container">
    @await Html.PartialAsync("AdminSidebar")

    <div class="admin-content">

        <div class="admin-content-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="section-title">
                        Редактирование пользователя
                    </h1>
                    <p class="subtitle">
                        #@Model?.ID.ToString()[..8].ToUpper()
                    </p>
                </div>

                <a asp-area="Admin"
                   asp-controller="User"
                   asp-action="Index"
                   class="btn btn-outline">
                    Назад
                </a>
            </div>
        </div>

        <div class="admin-content-body">

            @if (Model != null)
            {
                <div class="realEstate-card p-4 mb-4">

                    <h3 class="section-title mb-4">
                        Редактирование данных
                    </h3>

                    <form method="post"
                          asp-area="Admin"
                          asp-controller="User"
                          asp-action="Update">

                        <input type="hidden" asp-for="ID" />
                        <input type="hidden" name="Password" value="@Model.Password" />

                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label-custom">
                                    Логин *
                                </label>
                                <input asp-for="Login"
                                       class="form-control custom-input"
                                       placeholder="Введите логин"
                                       required/>
                                <span asp-validation-for="Login" class="field-validation text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label class="form-label-custom">
                                    Имя *
                                </label>
                                <input asp-for="FirstName"
                                       class="form-control custom-input"
                                       placeholder="Введите имя"/>
                                <span asp-validation-for="FirstName" class="field-validation text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label class="form-label-custom">
                                    Фамилия *
                                </label>
                                <input asp-for="LastName"
                                       class="form-control custom-input"
                                       placeholder="Введите фамилию"/>
                                <span asp-validation-for="LastName" class="field-validation text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label class="form-label-custom">
                                    Телефон *
                                </label>
                                <input asp-for="PhoneNumber"
                                       class="form-control custom-input"
                                       placeholder="Введите телефон" />
                                <span asp-validation-for="PhoneNumber" class="field-validation text-danger"></span>
                            </div>

                            
                            <div class="form-group">
                                <label class="form-label-custom">
                                    Отчество
                                </label>
                                <input asp-for="Patronymic"
                                       class="form-control custom-input"
                                        placeholder="Введите отчество" />
                                <span asp-validation-for="Patronymic" class="field-validation text-danger"></span>
                            </div>

                        </div>

                        <div class="form-actions mt-4">
                            <div class="button-group d-flex gap-3">
                                <button type="submit" class="btn btn-main px-4 py-2">
                                    Сохранить
                                </button>
                                <a asp-area="Admin"
                                   asp-controller="User"
                                   asp-action="Index"
                                   class="btn btn-outline px-4 py-2">
                                    Отмена
                                </a>
                            </div>
                        </div>

                    </form>
                </div>
            }
            else
            {
                <div class="info-placeholder">
                    <h3>Пользователь не найден</h3>
                    <p>Запрашиваемый пользователь не существует</p>
                </div>
            }

        </div>

    </div>
</div>
