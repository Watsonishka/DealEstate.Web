@model ChangePasswordViewModel

@{
    ViewData["Title"] = "Смена пароля";
}

<div class="admin-container">
    @await Html.PartialAsync("AdminSidebar")

    <div class="admin-content">

        <div class="admin-content-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="section-title">
                        Смена пароля
                    </h1>
                    <p class="subtitle">
                        Введите новый пароль для пользователя: <strong>@Model?.Login</strong>
                    </p>
                </div>               

                <a asp-area="Admin"
                   asp-controller="User"
                   asp-action="Index"
                   class="btn btn-outline">
                    Назад
                </a>
            </div>
        </div>

        <div class="admin-content-body">

            <div class="realEstate-card p-4 mb-4">

                <h3 class="section-title mb-4">
                    Смена пароля
                </h3>

                <form method="post"
                      asp-area="Admin"
                      asp-controller="User"
                      asp-action="ChangePassword">

                    <input type="hidden" asp-for="userID" />
                    <input type="hidden" asp-for="Login" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group">
                        <label class="form-label-custom" asp-for="Password">
                            Новый пароль *
                        </label>
                        <input asp-for="Password"
                               class="form-control custom-input"
                               placeholder="Введите новый пароль"
                               required />
                        <span asp-validation-for="Password" class="field-validation text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label-custom" asp-for="ConfirmPassword">
                            Подтверждение пароля *
                        </label>
                        <input asp-for="ConfirmPassword"
                               class="form-control custom-input"
                               placeholder="Подтвердите новый пароль"
                               required />
                        <span asp-validation-for="ConfirmPassword" class="field-validation text-danger"></span>
                    </div>

                    <div class="form-actions mt-4">
                        <div class="button-group d-flex gap-3">
                            <button type="submit" class="btn btn-main px-4 py-2">
                                Сохранить
                            </button>
                            <a asp-area="Admin"
                               asp-controller="User"
                               asp-action="Index"
                               class="btn btn-outline px-4 py-2">
                                Отмена
                            </a>
                        </div>
                    </div>
                </form>
            </div>

        </div>

    </div>
</div>