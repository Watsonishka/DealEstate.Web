@model UserViewModel

@{
    ViewData["Title"] = "Создание нового пользователя";
}

<div class="admin-container">
    @await Html.PartialAsync("AdminSidebar")

    <div class="admin-content">

        <div class="admin-content-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="section-title">
                        Создание нового пользователя
                    </h1>
                </div>

                <a asp-area="Admin"
                   asp-controller="User"
                   asp-action="Index"
                   class="btn btn-outline">
                    Назад
                </a>
            </div>
        </div>

        <div class="admin-content-body">

            <div class="realEstate-card p-4 mb-4">

                <h3 class="section-title mb-4">
                    Новый пользователь:
                </h3>

                <form method="post"
                      asp-area="Admin"
                      asp-controller="User"
                      asp-action="Add"
                      enctype="multipart/form-data">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label-custom" asp-for="Login">
                                Логин *
                            </label>
                            <input asp-for="Login"
                                   class="form-control custom-input"
                                   placeholder="Введите логин"
                                   required />
                            <span asp-validation-for="Login" class="field-validation text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label-custom" asp-for="FirstName">
                                Имя *
                            </label>
                            <input asp-for="FirstName"
                                   class="form-control custom-input"
                                   placeholder="Введите имя" />
                            <span asp-validation-for="FirstName" class="field-validation text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label-custom" asp-for="LastName">
                                Фамилия
                            </label>
                            <input asp-for="LastName"
                                   class="form-control custom-input"
                                   placeholder="Введите фамилию" />
                            <span asp-validation-for="LastName" class="field-validation text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label-custom" asp-for="Patronymic">
                                Отчество
                            </label>
                            <input asp-for="Patronymic"
                                   class="form-control custom-input"
                                   placeholder="Введите отчество" />
                            <span asp-validation-for="Patronymic" class="field-validation text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label-custom" asp-for="PhoneNumber">
                                Телефон *
                            </label>
                            <input asp-for="PhoneNumber"
                                   class="form-control custom-input"
                                   placeholder="Введите телефон" />
                            <span asp-validation-for="PhoneNumber" class="field-validation text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label-custom" asp-for="Password">
                                Пароль *
                            </label>
                            <input asp-for="Password"
                                   type="password"
                                   class="form-control custom-input"
                                   placeholder="Введите пароль" />
                            <span asp-validation-for="Password" class="field-validation text-danger"></span>
                        </div>
                    </div>

                    <div class="form-actions mt-4">
                        <div class="button-group d-flex gap-3">
                            <button type="submit" class="btn btn-main px-4 py-2">
                                Сохранить
                            </button>

                            <a asp-area="Admin"
                               asp-controller="User"
                               asp-action="Index"
                               class="btn btn-outline px-4 py-2">
                                Отмена
                            </a>
                        </div>
                    </div>
                </form>
            </div>

        </div>

    </div>
</div>