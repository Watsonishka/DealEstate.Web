@model List<OrderViewModel>
@{
	ViewData["Title"] = "Заказы";
}

<div class="admin-container">
	@await Html.PartialAsync("AdminSidebar")

	<div class="admin-content">
		<div class="admin-content-header">
			<h1 class="section-title">
				<i class="fas fa-shopping-cart"></i> Заказы
			</h1>
			<p class="subtitle">Управление заказами пользователей</p>
		</div>

		<div class="admin-content-body">
			@if (Model == null || !Model.Any())
			{
				<div class="info-placeholder">
					<i class="fas fa-shopping-cart fa-3x text-muted"></i>
					<h3>Заказов пока нет</h3>
					<p>Здесь будут отображаться сделанные пользователями заказы</p>
				</div>
			}

			else
			{
				<div class="stats-grid">
					<div class="stat-card stat-card-total">
						<h6>Всего заказов</h6>
						<h3>@Model.Count</h3>
					</div>
					<div class="stat-card stat-card-new">
						<h6>Новые</h6>
						<h3>@Model.Count(x => x.Status == OrderStatus.Created)</h3>
					</div>
					<div class="stat-card stat-card-processing">
						<h6>В обработке</h6>
						<h3>@Model.Count(x => x.Status == OrderStatus.InProgress)</h3>
					</div>
					<div class="stat-card stat-card-completed">
						<h6>Завершенные</h6>
						<h3>@Model.Count(x => x.Status == OrderStatus.Completed)</h3>
					</div>
				</div>

				<div class="orders-table-wrapper">
					<table class="orders-table">
						<thead>
							<tr>
								<th>№ заказа</th>
								<th>Пользователь</th>
								<th>Покупатель</th>
								<th>Сумма</th>
								<th>Статус</th>
								<th>Дата</th>
								<th>Действия</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var order in Model.OrderByDescending(x => x.CreatedAt))
							{
								<tr>
									<td>
										<span class="order-id">#@order.ID.ToString()[..6].ToUpper()</span>
									</td>
									<td class="user-id">@order.UserID</td>
									<td>
										@if (order.DeliveryUser != null)
										{
											<div class="customer-info">
												<span class="customer-name">@order.DeliveryUser.LastName @order.DeliveryUser.FirstName @order.DeliveryUser.Patronymic</span>
												<span class="customer-phone">@order.DeliveryUser.PhoneNumber</span>
											</div>
										}
										else
										{
											<span class="text-muted">Не указан</span>
										}
									</td>
									<td class="customer-info">@((order.ManagerReward + order.ServicesTotalPrice).ToString("C"))</td>
									<td>
										<form asp-area="Admin"
											  asp-controller="Order"
											  asp-action="UpdateStatus"
											  method="post"
											  class="status-form">
											<input type="hidden" name="orderId" value="@order.ID" />
											<select name="status"
													class="status-select @(order.Status == OrderStatus.Created ? "status-new" :
																										 order.Status == OrderStatus.InProgress ? "status-processing" :
																										 order.Status == OrderStatus.Completed ? "status-completed" :
																										 "status-default")"
													onchange="this.form.submit()">
												@foreach (OrderStatus status in Enum.GetValues(typeof(OrderStatus)))
												{
													<option value="@status" selected="@(status == order.Status)">
														@EnumHelper.GetDescription(status)
													</option>
												}
											</select>
										</form>
									</td>
									<td class="order-date">@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
									<td>
										<div class="action-buttons">
											<a asp-area="Admin"
											   asp-controller="Order"
											   asp-action="Show"
											   asp-route-orderId="@order.ID"
											   class="btn-action">
												<i class="fas fa-eye"></i>
											</a>
										</div>
									</td>
								</tr>
							}
						</tbody>
						<tfoot>
							<tr>
								<td colspan="3" class="footer-label">Итого заказов:</td>
								<td colspan="4" class="footer-count">@Model.Count</td>
							</tr>
						</tfoot>
					</table>
				</div>
			}
		</div>
	</div>
</div>