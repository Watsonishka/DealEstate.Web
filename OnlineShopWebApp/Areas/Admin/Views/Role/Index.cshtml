@model List<RoleViewModel>
@{
    ViewData["Title"] = "Роли";
}

<div class="admin-container">
    @await Html.PartialAsync("AdminSidebar")

    <div class="admin-content">
        <div class="admin-content-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="section-title">
                        <i class="fas fa-tags"></i> Роли
                    </h1>
                    <p class="subtitle">Управление ролями и правами доступа</p>
                </div>
                <a asp-area="Admin"
                   asp-controller="Role"
                   asp-action="Add"
                   class="btn btn-main admin-add-btn">
                    <i class="fas fa-plus"></i>
                    Добавить роль
                </a>
            </div>
        </div>

        <div class="admin-content-body">
            @if (Model == null || !Model.Any())
            {
                <div class="info-placeholder">
                    <i class="fas fa-tags fa-3x text-muted"></i>
                    <h3>Ролей пока нет</h3>
                    <p>Создайте первую роль, чтобы начать управление правами доступа</p>
                </div>
            }
            else
            {
                <div class="orders-table-wrapper">
                    <table class="orders-table">
                        <thead>
                            <tr>
                                <th style="width: 70%;">Название роли</th>
                                <th style="width: 30%; text-align: center;">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in Model.OrderBy(r => r.Name))
                            {
                                <tr>
                                    <td>
                                        <span class="role-name">@role.Name</span>
                                        @if (!role.IsCustom)
                                        {
                                            <span class="badge" style="background: #6c757d; color: white; font-size: 11px; margin-left: 10px; padding: 3px 10px; border-radius: 12px;">
                                                <i class="fas fa-lock"></i> Системная
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div style="text-align: right;">
                                            @if (role.IsCustom)
                                            {
                                                <button type="button" class="btn btn-main"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal_@role.ID">
                                                    <i class="fas fa-trash"></i> Удалить роль
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-outline" disabled
                                                        title="Системную роль нельзя удалить">
                                                    <i class="fas fa-lock"></i> Нельзя удалить
                                                </button>
                                            }
                                        </div>

                                        <div class="modal fade" id="deleteModal_@role.ID" tabindex="-1" aria-labelledby="modalWindow_@role.ID" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="modalWindow_@role.ID">
                                                            <i class="fas fa-trash"></i>
                                                            Удаление
                                                        </h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <form method="post"
                                                          asp-area="Admin"
                                                          asp-controller="Role"
                                                          asp-action="Delete"
                                                          asp-route-roleID="@role.ID">
                                                        <div class="modal-body">
                                                            <p>Удалить выбранную роль <strong style="color: #c59d5f;">@role.Name</strong>?</p>
                                                            <p class="customer-info">Данное действие нельзя отменить.</p>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-outline" data-bs-dismiss="modal">Отмена</button>
                                                            <button type="submit" class="btn btn-outline">Удалить</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="2" class="footer-label">Итого ролей: @Model.Count</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>